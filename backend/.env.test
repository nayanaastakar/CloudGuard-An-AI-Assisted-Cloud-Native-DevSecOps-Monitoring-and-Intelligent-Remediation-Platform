# Test Environment Configuration
# This file is used during pytest runs

# Disable database and Redis for unit tests
USE_DATABASE_AUTH=false
REDIS_ENABLED=false

# Test mode settings
DEBUG=true
DEMO_MODE=true

# Minimal required settings
SECRET_KEY=test-secret-key-for-unit-tests-only
API_PREFIX=/api/v1
APP_NAME=CloudGuard
APP_VERSION=2.0.0
APP_TITLE=CloudGuard: An AI-Assisted Cloud-Native DevSecOps Monitoring and Intelligent Remediation Platform
HELM_AUTO_INIT=false
