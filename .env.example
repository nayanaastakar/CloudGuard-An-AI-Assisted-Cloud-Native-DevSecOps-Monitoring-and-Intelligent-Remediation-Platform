# CloudGuard Environment Configuration
# Project: CloudGuard - An AI-Assisted Cloud-Native DevSecOps Monitoring and Intelligent Remediation Platform

# Application Identity
APP_NAME=CloudGuard
APP_TITLE=CloudGuard – An AI-Assisted Cloud-Native DevSecOps Monitoring and Intelligent Remediation Platform
APP_TAGLINE=Secure, Analyse and Optimise Your Cloud-Native Infrastructure.
APP_VERSION=2.0.0
DEBUG=false

# Port Bindings (Isolated from KubeSight)
FRONTEND_PORT=3001
BACKEND_PORT=8001
POSTGRES_PORT=5433
REDIS_PORT=6380

# Database Configuration (PostgreSQL)
POSTGRES_USER=cloudguard
POSTGRES_PASSWORD=cloudguard_secret_change_me
POSTGRES_DB=cloudguard_db
DATABASE_URL=postgresql+asyncpg://cloudguard:cloudguard_secret_change_me@postgres:5432/cloudguard_db
USE_DATABASE_AUTH=true

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Security & Tokens
SECRET_KEY=generate-a-secure-random-secret-key-for-cloudguard
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Kubernetes Configuration
K8S_IN_CLUSTER=false
K8S_CONFIG_PATH=/home/cloudguard/.kube/config
K8S_HOST_OVERRIDE=host.docker.internal

# AI Security Investigation (Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Trivy Security Scanner
TRIVY_ENABLED=true
TRIVY_TIMEOUT=300
TRIVY_SEVERITY=CRITICAL,HIGH,MEDIUM,LOW

# DevSecOps
GITLEAKS_ENABLED=true
CI_SECURITY_GATES=true
