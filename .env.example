# CloudGuard Environment Configuration
# Project: CloudGuard - An AI-Assisted Cloud-Native DevSecOps Monitoring and Intelligent Remediation Platform

# Application Identity
APP_NAME=CloudGuard
APP_TITLE=CloudGuard – An AI-Assisted Cloud-Native DevSecOps Monitoring and Intelligent Remediation Platform
APP_TAGLINE=Secure, Analyse and Optimise Your Cloud-Native Infrastructure.
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# Port Bindings (Isolated from KubeSight)
FRONTEND_PORT=3001
BACKEND_PORT=8001
POSTGRES_PORT=5433
REDIS_PORT=6380

# Database Configuration (PostgreSQL)
POSTGRES_USER=cloudguard
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_DB=cloudguard_db
DATABASE_URL=postgresql+asyncpg://cloudguard:replace-with-a-long-random-url-safe-password@postgres:5432/cloudguard_db
USE_DATABASE_AUTH=true

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Security & Tokens
SECRET_KEY=replace-with-at-least-32-random-characters
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-local-admin-password
FALCO_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Kubernetes Configuration
K8S_IN_CLUSTER=false
K8S_CONFIG_PATH=/home/cloudguard/.kube/config
K8S_HOST_OVERRIDE=host.docker.internal
K8S_SKIP_TLS_VERIFY=false

# AI Security Investigation (Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Trivy Security Scanner
TRIVY_ENABLED=true
TRIVY_TIMEOUT=300
TRIVY_SEVERITY=CRITICAL,HIGH,MEDIUM,LOW

# DevSecOps
GITLEAKS_ENABLED=true
CI_SECURITY_GATES=true
